\node[fill=dataC,text=white] (b) at (3.05,0) {2. Example};
\node[fill=skillC,text=white] (c) at (6.1,0) {3. Mathematics};
\node[fill=gold,text=navy] (d) at (9.15,0) {4. Algorithm};
\node[fill=gray!60,text=white] (e) at (0,-1.5) {5. Code};
\node[fill=saffron,text=white] (f) at (3.05,-1.5) {6. Applications\\\& products};
\node[fill=sun,text=white] (g) at (6.1,-1.5) {7. Our result};
\node[fill=warnC,text=white] (h) at (9.15,-1.5) {Pitfalls};
\foreach \x/\y in {a/b,b/c,c/d} \draw[-{Stealth},thick,gold] (\x)--(\y);
